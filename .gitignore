# monday Master Builder: development workspace (design, research, fixtures, review folder, handoff).
# The plugin itself is its own repository, cloned beside this one into monday-master-builder/.
monday-master-builder/

# Test client folders hold bound-account details while the plugin is tested (A22); never tracked.
clients/*
!clients/.gitkeep

# This folder is the development home (MMB_HOME) for the demo builds (A31). What `record.py home init`
# and the scripts write beside clients/ holds the user's own settings and ids; never tracked.
/local/
/archive/
/cards/
/sandbox/
/monday-knowledge/
/clients-index.json
/.work/

# Scratch and generated files
__pycache__/
*.py[cod]
.DS_Store
